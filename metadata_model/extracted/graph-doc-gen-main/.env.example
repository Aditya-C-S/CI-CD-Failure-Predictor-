# Graph Engine (graph-doc-gen) - Environment Configuration Example
# ==================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit your actual .env file to version control

# Neo4j Configuration (required)
# NEO4J_URI: Connection string for Neo4j
#   - Local instance: bolt://localhost:7687 or bolt://localhost:7688
#   - Remote instance: bolt://hostname:7687
# NEO4J_USERNAME: Neo4j username (default: neo4j)
# NEO4J_PASSWORD: Neo4j password (must be changed from default in production)
# NEO4J_DATABASE: Database name where graph is stored
#   - Used by ORC: "graphdoc" (required for repository isolation)
#   - Can be different if not used with ORC
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=graphdoc

# Google GenAI Configuration (optional, for code embeddings)
# GEMINI_API_KEY: Google Gemini API key for generating node embeddings
#   - If not set, node embeddings will be disabled (optional feature)
# Get API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# GROQ Configuration (optional, for LLM-based analysis)
# GROQ_API_KEY: Groq API key (if using Groq-based features)
#   - Leave blank if not using Groq
GROQ_API_KEY=
