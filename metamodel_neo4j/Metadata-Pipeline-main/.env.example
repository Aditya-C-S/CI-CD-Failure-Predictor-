# Metadata Pipeline - Environment Configuration Example
# =====================================================
# Copy this file to .env and fill in your actual values
# NEVER commit your actual .env file to version control

# GitHub API Token (required)
# Create a Personal Access Token at https://github.com/settings/personal-access-tokens
# Required scopes: repo (for accessing repositories)
# Supports both classic PAT (github_pat_...) and fine-grained tokens
GITHUB_TOKEN=your_github_pat_here

# Ngrok Authentication (optional, only for webhook mode)
# Get your auth token at https://dashboard.ngrok.com
# Required if you want to use webhook listener mode with automated GitHub webhook registration
# Leave blank to use unauthenticated tunnel (limited features)
NGROK_AUTHTOKEN=your_ngrok_token_here

# Optional: Metadata Extractor cache directory
# Defaults to .repo_cache in this directory
# REPO_CACHE_DIR=/path/to/cache

# Optional: Max concurrent feature extraction jobs
# Defaults to 4
# EXTRACTION_WORKERS=4
