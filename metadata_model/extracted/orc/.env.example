# ORC Orchestrator - Environment Configuration Example
# =====================================================
# Copy this file to .env and fill in your actual values
# NEVER commit your actual .env file to version control

# GitHub API Token (required)
# Create a Personal Access Token at https://github.com/settings/personal-access-tokens
# Required scopes: repo (for accessing repositories)
GITHUB_TOKEN=your_github_pat_here

# Neo4j Configuration (required)
# NEO4J_URI: Connection string for Neo4j
#   - Local instance: bolt://localhost:7687 or bolt://localhost:7688
#   - Remote instance: bolt://hostname:7687
# NEO4J_USERNAME: Neo4j username (default: neo4j)
# NEO4J_PASSWORD: Neo4j password (must be changed from default in production)
# NEO4J_DATABASE: Database name (must be "graphdoc" - this is where graph data is stored)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=graphdoc

# Orchestrator Configuration (optional, uses defaults if not set)
# INVESTIGATION_THRESHOLD: Risk probability threshold for investigating suspicious files
#   - Below this threshold: skip investigation (faster)
#   - At or above this threshold: investigate connected files in graph
#   - Range: [0.0, 1.0], default: 0.50
INVESTIGATION_THRESHOLD=0.50

# MAX_RETRIES: Maximum retry attempts for transient failures
#   - Range: 1-10, default: 3
MAX_RETRIES=3

# RETRY_BACKOFF_SECONDS: Initial backoff time for exponential retry (in seconds)
#   - First retry waits 2.0s, second waits 4.0s, etc.
#   - Range: 0.1-10.0, default: 2.0
RETRY_BACKOFF_SECONDS=2.0
