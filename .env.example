# Environment Variables Example for CI/CD Failure Predictor
# Copy to .env for local overrides

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=False

# Default Failure Predictor Settings
# Options: logistic_regression, svm, modernbert, bilstm
DEFAULT_MODEL=logistic_regression

# Default Visibility Depth Percentage
# Options: 25, 50, 75, 100
DEFAULT_VISIBILITY=25

# Optional External Demo Repository Location (defaults to sibling ../demo-order-service)
# DEMO_ORDER_SERVICE_PATH=../demo-order-service

# Optional Shared Secret for CI Log Ingestion Authentication
# When set, POST /api/demo/runs/{run_id}/logs requires header 'X-API-Key' or 'Authorization: Bearer'
# DEMO_API_KEY=your_secure_random_token_here

